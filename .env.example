PORT=4000
HOST=0.0.0.0
# MAMP MySQL
DB_HOST=127.0.0.1
DB_PORT=8889
DB_USER=root
DB_PASSWORD=root
DB_NAME=upravko
# Obavezno promeni u produkciji (najmanje 32 karaktera)
JWT_SECRET=dev-only-secret-change-me-please-32chars
# Javna adresa API-ja (koristi se za potpisane linkove ka fajlovima)
PUBLIC_URL=http://localhost:4000
# Proksiji kojima se veruje X-Forwarded-For (podrazumevano lokalna mreža, npr. Cloudflare tunel)
# TRUST_PROXY=loopback,linklocal,uniquelocal
# Dozvoljeni web klijenti (website/CRM), odvojeni zarezom
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
STORAGE_DIR=./storage
# SMTP; prazno = e-mail se ispisuje u log (MAMP MailHog: 127.0.0.1:1025)
SMTP_URL=
MAIL_FROM=Upravko <no-reply@upravko.rs>
# Deep link u mobilnoj aplikaciji
APP_LINK=upravko://
# Samo za razvoj: skoro zaustavlja sat na datumu iz dizajna, da seed podaci
# (rok glasanja, "juče", "ovog meseca") uvek izgledaju kao na ekranima.
# U produkciji ostaviti prazno.
DEMO_NOW=2026-10-30T11:00:00+01:00
